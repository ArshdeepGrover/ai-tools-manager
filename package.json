{
  "name": "ai-tools-hub",
  "version": "1.0.0",
  "description": "AI Tools Directory",
  "scripts": {
    "check-duplicates": "node scripts/validate-links.js --duplicates-only",
    "validate": "node scripts/validate-links.js",
    "validate-contributors": "node scripts/validate-contributors.js",
    "validate-json": "node -e \"['data/links.json','data/contributors.json'].forEach(function(f){try{JSON.parse(require('fs').readFileSync(f,'utf8'));console.log('\\u2713 valid JSON: '+f)}catch(e){console.error('\\u2717 invalid JSON in '+f+': '+e.message);process.exit(1)}})\"",
    "build:css": "tailwindcss -i tailwind.input.css -o tailwind.css --minify",
    "watch:css": "tailwindcss -i tailwind.input.css -o tailwind.css --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Arshdeep Singh",
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.10.1",
    "tailwindcss": "3.4"
  }
}
